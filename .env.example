# AI Provider for Prompt Synthesis & Refinement (OpenAI, OpenRouter, Groq, DeepSeek, etc.)
OPENAI_API_KEY=your_ai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# Speech-to-Text: Groq Whisper Large v3 (Fast transcription for Egyptian Arabic & English)
GROQ_API_KEY=your_groq_api_key_here
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# Supabase (Database, Auth, and Cross-Device Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
